# Kept small on purpose: the build context is uploaded to Cloud Build on every deploy,
# and .venv plus node_modules is several hundred megabytes of files the image rebuilds
# from the lockfiles anyway.
.git
.venv
node_modules
apps/web/.next
apps/web/node_modules
**/__pycache__
**/*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
.localstore
htmlcov
.coverage
coverage.xml
*.md
!prompts/*.md
.env
.env.*
!.env.example
docs/
evals/reports/
