# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Defaults here are the local-development values, which cost nothing and need no
# Google Cloud credentials: `make up` starts Postgres with pgvector, the Pub/Sub
# emulator, and the Firebase Auth emulator. The cloud values are marked.

# local | cloud. `cloud` makes the variables in the CLOUD section mandatory and
# switches the database to the AlloyDB connector with IAM authentication.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Google Cloud project
# --------------------------------------------------------------------------

# Your sandbox project id. Also used as the audience when verifying Identity
# Platform ID tokens, so it must be right even in local development.
GOOGLE_CLOUD_PROJECT=CHANGEME-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=CHANGEME-project-number

# Where Cloud Run, AlloyDB, Cloud Tasks and Cloud Scheduler live. This is not the
# same as the Vertex AI location below, and conflating them produces a 404 at
# runtime. See docs/adr/0002-region-and-vertex-endpoints.md.
GOOGLE_CLOUD_REGION=us-central1

# --------------------------------------------------------------------------
# Vertex AI
# --------------------------------------------------------------------------

# Model ids are configurable because Vertex retires models on a published
# schedule. These were checked against the model reference on 2026-09-11.
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_GENERATE_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Generative Gemini 3.x models are served from `global` and the `us`/`eu`
# multi-regions only. `global` is also about 10% cheaper per token than a
# regional endpoint.
VERTEX_LOCATION=global

# gemini-embedding-001 is a regional model and is not served from `global`.
EMBEDDING_REGION=us-central1

# 768 via Matryoshka truncation. pgvector indexes the `vector` type up to 2,000
# dimensions, so 3072 cannot be a plain indexed vector; 768 is chosen over the
# halfvec alternative for index size and memory. Changing this is a re-embed job.
EMBEDDING_DIM=768

GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=120

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------

DB_NAME=jobtrack
# The application role. It owns nothing: row-level security is only enforced
# against non-owners, and the app connecting as the table owner would make every
# policy in the schema decorative.
DB_APP_USER=jobtrack_app

# LOCAL only. This password is a docker compose fixture, not a secret.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_PASSWORD=jobtrack

# CLOUD only. The AlloyDB Python Connector takes the instance URI and
# authenticates as the Cloud Run service account; there is no password.
# Format: projects/PROJECT/locations/REGION/clusters/CLUSTER/instances/INSTANCE
DB_ALLOYDB_INSTANCE_URI=

# --------------------------------------------------------------------------
# Emulators (LOCAL only; leave empty in cloud)
# --------------------------------------------------------------------------

PUBSUB_EMULATOR_HOST=localhost:8085
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --------------------------------------------------------------------------
# Cloud Storage (CLOUD only)
# --------------------------------------------------------------------------

# Uploaded resumes, raw job-posting payloads kept for re-extraction, and rendered
# documents. Separate buckets so lifecycle and access differ per class of object.
GCS_UPLOADS_BUCKET=
GCS_RAW_BUCKET=
GCS_ARTIFACTS_BUCKET=

# --------------------------------------------------------------------------
# Internal endpoints
# --------------------------------------------------------------------------

# Comma-separated service account emails allowed to call /internal/*. Empty means
# nobody can, which is the correct default: an internal endpoint that accepts an
# unknown caller is an open endpoint.
INTERNAL_INVOKER_ACCOUNTS=

# --------------------------------------------------------------------------
# Web app (browser)
# --------------------------------------------------------------------------
#
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle at build time and are
# visible to anyone who opens the page. None of them is a credential: a Firebase web
# API key identifies the project, and what protects data is the ID token the user
# signs in for plus the row-level security policies behind the API.
#
# Copy these into apps/web/.env.local as well; Next reads its own file.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Origins the api accepts browser requests from. Comma-separated; never "*",
# because every request carries an Authorization header.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGEME-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key

# LOCAL only. Leave empty in cloud: the emulator issues unsigned tokens, and the api
# refuses to start with ENVIRONMENT=cloud while this is set.
NEXT_PUBLIC_AUTH_EMULATOR_HOST=localhost:9099

# --------------------------------------------------------------------------
# Model backend
# --------------------------------------------------------------------------

# vertex | heuristic | cassette. `heuristic` is rule-based, runs in-process, needs no
# credentials, and is the default locally. `cloud` requires `vertex`.
# See docs/adr/0010-llm-boundary-and-offline-operation.md.
LLM_BACKEND=heuristic
